# Reviewed deployment candidate; install paths and identity are operator-owned.
[Unit]
Description=LPX Keepmorrow private preservation service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=keepmorrow
Group=keepmorrow
UMask=0077
WorkingDirectory=/var/lib/keepmorrow
ExecStart=/opt/keepmorrow/venv/bin/keepmorrow-service serve --configuration /etc/keepmorrow/service.json
EnvironmentFile=/etc/keepmorrow/credentials.env
# Restart invokes journal reconciliation; it does not establish power-loss durability.
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Keep state, outputs, and owned scratch under this root on one filesystem.
ReadWritePaths=/var/lib/keepmorrow
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
