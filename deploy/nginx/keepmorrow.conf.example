# Replace the origin and certificate paths only after selecting the actual host.
# This example uses the default HTTPS port; public_origin must match this host.
# OAuth establishes caller identity independently of proxy-supplied headers.
server {
    listen 443 ssl;
    server_name keepmorrow.example.com;
    ssl_certificate /etc/keepmorrow/tls/fullchain.pem;
    ssl_certificate_key /etc/keepmorrow/tls/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Align this ceiling with the service upload limit; application checks remain
    # authoritative for each route, principal, and streamed payload.
    client_max_body_size 128m;
    client_body_timeout 30s;
    # Resource-bearing request URLs must not enter the default access log.
    access_log off;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        # Leave upload and response flow under the application's bounded I/O.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
